.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage
coverage/
htmlcov/

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
